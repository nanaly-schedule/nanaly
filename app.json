{
  "expo": {
    "name": "나날이",
    "slug": "nanaly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/logo.png",
    "scheme": "nanaly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nanaly.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4E80EE",
        "foregroundImage": "./src/shared/assets/logo.png",
        "backgroundImage": "./src/shared/assets/logo.png",
        "monochromeImage": "./src/shared/assets/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nanaly.app"
    },
    "web": {
      "output": "static",
      "favicon": "./src/shared/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/logo_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4E80EE",
          "dark": {
            "backgroundColor": "#4E80EE"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/shared/assets/logo.png",
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.627677607110-t2n97mo1p1pvpsmh3dq8339eug6st3e6"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf34d7b5-0469-42d5-902b-fcb3e88ca859"
      }
    },
    "owner": "nanaly"
  }
}
